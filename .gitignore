# Generated Xcode project (recreate with `xcodegen generate`)
*.xcodeproj/

# Xcode user data & build output
xcuserdata/
DerivedData/
build/
*.xcuserstate

# macOS
.DS_Store

# Release artifacts
*.dmg

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Serena MCP project cache
.serena/

# Local signing override — keeps the Apple Team ID out of version control.
# (Config/Signing.xcconfig itself is a committed stub that optionally includes this.)
Config/Signing.local.xcconfig

# Local ad hoc OTA publish script — references personal homelab infra
# (builds.dimitryvin.com portal); intentionally untracked in the public repo.
scripts/adhoc-release.sh
.adhoc-release.env
